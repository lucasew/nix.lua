#!/bin/bash
set -e

# Automatically enter nix-shell if available and not already inside one
if [ -f shell.nix ] && [ -z "$IN_NIX_SHELL" ] && command -v nix-shell >/dev/null 2>&1; then
    echo "Entering nix-shell..."
    # Quote arguments to prevent splitting issues when passed to nix-shell --run
    CMD="$0"
    for arg in "$@"; do
        CMD="$CMD \"$arg\""
    done
    exec nix-shell --run "$CMD"
fi

COMMAND=$1
SUBCOMMAND=$2

has_tool() {
    command -v "$1" >/dev/null 2>&1
}

if [ "$COMMAND" = "codebase" ]; then
    if [ "$SUBCOMMAND" = "lint" ]; then
        echo "Running lint check..."
        if has_tool clang-tidy; then
            FILES=$(find . -name "*.cc" -o -name "*.hh" 2>/dev/null || true)
            if [ -n "$FILES" ]; then
                echo "NIX_CFLAGS_COMPILE: $NIX_CFLAGS_COMPILE"
                # shellcheck disable=SC2086
                clang-tidy $FILES -- $NIX_CFLAGS_COMPILE
            else
                echo "No source files found."
            fi
        else
            echo "Error: clang-tidy not found."
            exit 1
        fi
    elif [ "$SUBCOMMAND" = "format" ]; then
        echo "Running format check..."
        if has_tool clang-format; then
            FILES=$(find . -name "*.cc" -o -name "*.hh" 2>/dev/null || true)
            if [ -n "$FILES" ]; then
                # shellcheck disable=SC2086
                clang-format -i $FILES
            else
                echo "No source files found."
            fi
        else
            echo "Error: clang-format not found."
            exit 1
        fi
    else
        echo "Unknown subcommand: $SUBCOMMAND"
        exit 1
    fi
else
    echo "Unknown command: $COMMAND"
    exit 1
fi
